# Copy this file to .env and fill in local values. Never commit .env.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Local PostgreSQL connection string. For a Render External Database URL, require TLS:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jelajah
# Render Web Service should use the database INTERNAL URL from the same region.
# For external connections, include ?sslmode=require at the end of DATABASE_URL (Render External URL does this).
PG_POOL_MAX=10
